# Clerk — REQUIRED for full auth features (https://dashboard.clerk.com/apikeys)
# Leave empty to run the app in guest/fallback mode (booking + "my bookings" disabled).
VITE_CLERK_PUBLISHABLE_KEY=

# Backend API base URL
# Local dev: http://localhost:5000/api
# Production: https://your-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Stripe publishable key (pk_...) — REQUIRED for card payments (https://dashboard.stripe.com/apikeys)
# Leave empty to fall back to "pay at hotel" bookings.
VITE_STRIPE_PUBLISHABLE_KEY=
