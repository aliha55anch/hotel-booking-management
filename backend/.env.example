# Server
PORT=5000
NODE_ENV=development

# Browser origins allowed to call this API in production (comma-separated).
# REQUIRED in production — when unset, cross-origin browser requests are blocked.
# Example: CORS_ORIGIN=https://your-app.vercel.app,https://your-app.example.com
CORS_ORIGIN=

# MongoDB connection string (https://www.mongodb.com/atlas)
MONGO_URI=

# JWT — REQUIRED for authentication. Use a long random string:
# openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# Password for the bootstrap admin created by `npm run seed:admin`
# (admin@test.com). seed:admin refuses to run without this.
ADMIN_PASSWORD=

# Stripe — REQUIRED for card payments (https://dashboard.stripe.com/apikeys).
# Use live keys (sk_live_...) in production and set the webhook endpoint secret
# (whsec_...) from the Stripe dashboard webhook for your production URL.
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Email sending (nodemailer, Gmail) — used for booking confirmations.
# EMAIL_PASS is a Gmail app password (https://myaccount.google.com/apppasswords).
# Emails are only sent in production unless EMAIL_ENABLED=true (set true in dev
# if you want real emails while developing).
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_ENABLED=false
