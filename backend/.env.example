# Server
PORT=5000
NODE_ENV=development

# Browser origins allowed to call this API in production (comma-separated).
# Leave empty in development to allow all origins.
# Example: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# MongoDB connection string (https://www.mongodb.com/atlas)
MONGO_URI=

# Clerk — REQUIRED for real authentication (https://dashboard.clerk.com/apikeys)
# Leave empty for dev fallback mode: every request acts as DEV_USER_ID.
# NOTE: fallback mode is disabled when NODE_ENV=production (auth returns 503).
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_WEBHOOK_SECRET=whsec_clerk_xxxx

# User id used in fallback mode when Clerk keys are empty.
# This must match an existing User.clerkId (see backend/tests) or the seed script.
DEV_USER_ID=test_clerk_admin

# Stripe — REQUIRED for card payments (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Email sending (nodemailer) — used for booking confirmations
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
